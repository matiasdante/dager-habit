{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "library",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/icons/*.png", "/reading-desk.jpg", "/media/*.woff2"]
      }
    }
  ],
  "navigationUrls": ["/", "/index.html"]
}
